{
  "name": "@hb/rent-car-tools-mcp-server",
  "version": "1.0.0-beta.17",
  "description": "租车工具mcp服务",
  "type": "module",
  "bin": {
    "mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "NODE_OPTIONS=\"--loader ts-node/esm\" node --trace-warnings src/index.ts ",
