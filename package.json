    "dotenv": "^17.0.0",
    "express": "^4.18.2",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "qrcode-generator": "^2.0.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.24",
    "@types/node-fetch": "^2.6.12",
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.9",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=16.0.0"
  }
